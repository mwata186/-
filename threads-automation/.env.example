# Anthropic API（Claude）
ANTHROPIC_API_KEY=sk-ant-...

# Threads API（Meta）
# 取得方法: https://developers.facebook.com でアプリ作成 → Threads API 追加 → User Token Generator
THREADS_USER_ID=<Meta User ID（数字）>
THREADS_ACCESS_TOKEN=<Threads API Long-lived Access Token>

# YouTube Data API v3（リサーチャーで使用）
# 取得方法: https://console.cloud.google.com で YouTube Data API v3 を有効化 → APIキー発行
YOUTUBE_API_KEY=<Google YouTube Data API v3 Key>
